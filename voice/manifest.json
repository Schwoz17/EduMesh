 },
 {
  "id": "en-0c447e5d",
  "lang": "en",
  "yarn_lang": "english",
  "speaker": "idera",
  "text": "For English, press 1. For Pidgin, press 2. For Yoruba, press 3. For Igbo, press 4. For Hausa, press 5.",
  "where": "call: welcome"
 },
 {
  "id": "en-eec49cde",
  "lang": "en",
  "yarn_lang": "english",
  "speaker": "idera",
